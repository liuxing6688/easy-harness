{
  "version": 1,
  "gatedPaths": {
    "sourceDirs": [
      "src",
      "src-tauri",
      "app",
      "cmd",
      "lib",
      "internal",
      "pkg",
      "tests",
      "test",
      "__tests__",
      "spec",
      "components",
      "pages",
      "api",
      "services",
      "handlers",
      "crates",
      "backend",
      "frontend",
      "server",
      "client",
      "web",
      "mobile",
      "ios",
      "android",
      "infra",
      "infrastructure",
      "migrations",
      "db",
      "database"
    ],
    "buildManifests": [
      "package.json",
      "pyproject.toml",
      "go.mod",
      "Cargo.toml",
      "pom.xml",
      "build.gradle",
      "build.gradle.kts",
      "Gemfile",
      "composer.json",
      "CMakeLists.txt",
      "Makefile",
      "setup.py",
      "setup.cfg",
      "requirements.txt",
      "Pipfile",
      "mix.exs",
      "pubspec.yaml"
    ],
    "testConfigs": [
      "vitest.config.ts",
      "vitest.config.js",
      "jest.config.js",
      "jest.config.ts",
      "pytest.ini",
      "phpunit.xml",
      "playwright.config.ts",
      "cypress.config.ts",
      "karma.conf.js"
    ],
    "rootPatterns": [
      "Dockerfile*",
      "docker-compose*.yml",
      "docker-compose*.yaml",
      ".env*",
      ".github/**",
      ".gitlab-ci.yml",
      "Jenkinsfile",
      "Taskfile.yml",
      "justfile",
      "mise.toml",
      ".tool-versions",
      "openapi*.yaml",
      "openapi*.yml",
      "openapi*.json",
      "schema*.sql",
      "terraform/**",
      "helm/**",
      "k8s/**",
      "kubernetes/**"
    ],
    "docsAllowedExtensions": [".md", ".mdx", ".txt"],
    "extensionGateExemptDirs": [
      "node_modules",
      "dist",
      "build",
      "out",
      "target",
      "coverage",
      "vendor",
      ".venv",
      "venv",
      "env",
      "__pycache__",
      ".tox",
      ".mypy_cache",
      ".pytest_cache",
      ".next",
      ".nuxt",
      ".svelte-kit",
      ".output",
      ".turbo",
      ".parcel-cache",
      "test-results",
      "playwright-report",
      ".git",
      ".idea",
      ".vs",
      "tmp",
      "temp",
      "bin",
      "obj",
      "Pods",
      ".gradle",
      ".dart_tool"
    ],
    "dotClaudeExemptPatterns": [
      ".claude/templates/**",
      ".claude/harness-state.json",
      ".claude/hooks.json",
      ".claude/harness.config.json",
      ".claude/hooks/.toolchain-install-approved.json",
      ".claude/hooks/.root-conversation-id.json",
      ".claude/hooks/.dispatched-roles.json"
    ]
  },
  "gatedShellPatterns": [
    "\\bnpm\\s+create\\b",
    "\\bnpm\\s+install\\b",
    "\\bnpm\\s+i\\b",
    "\\bnpm\\s+ci\\b",
    "\\bnpm\\s+add\\b",
    "\\bnpx\\s+create-",
    "\\bnpx\\s+@",
    "\\bpnpm\\s+create\\b",
    "\\bpnpm\\s+(install|i|add)\\b",
    "\\byarn\\s+create\\b",
    "\\byarn\\s+(install|add)\\b",
    "\\bbun\\s+(install|add|create)\\b",
    "\\bcargo\\s+init\\b",
    "\\bcargo\\s+new\\b",
    "\\bcargo\\s+add\\b",
    "create-tauri-app",
    "\\bnpm\\s+run\\s+tauri\\b",
    "\\bnpx\\s+tauri\\b",
    "\\bdotnet\\s+new\\b",
    "\\bdotnet\\s+add\\s+package\\b",
    "\\bdjango-admin\\s+startproject\\b",
    "\\bpip3?\\s+install\\b",
    "\\bpoetry\\s+init\\b",
    "\\bpoetry\\s+(add|install)\\b",
    "\\buv\\s+(init|add|sync|pip)\\b",
    "\\bconda\\s+install\\b",
    "\\bgo\\s+mod\\s+init\\b",
    "\\bgo\\s+get\\b",
    "\\bmvn\\s+archetype:generate\\b",
    "\\bgradle\\s+init\\b",
    "\\brails\\s+new\\b",
    "\\bflutter\\s+create\\b",
    "\\bflutter\\s+pub\\s+(get|add)\\b",
    "\\bdart\\s+pub\\s+(get|add)\\b",
    "\\bbundle\\s+init\\b",
    "\\bbundle\\s+install\\b",
    "\\bgem\\s+install\\b",
    "\\bcomposer\\s+create-project\\b",
    "\\bcomposer\\s+(install|require)\\b"
  ],
  "toolchain": {
    "approvalTtlMinutes": 60,
    "approvalMarkerFile": ".claude/hooks/.toolchain-install-approved.json",
    "installPatterns": [
      "\\bwinget\\s+install\\b",
      "rustup-init",
      "\\bchoco\\s+install\\b",
      "\\bscoop\\s+install\\b",
      "\\bbrew\\s+install\\b",
      "\\bapt(-get)?\\s+install\\b",
      "\\byum\\s+install\\b",
      "\\bdnf\\s+install\\b",
      "\\bpacman\\s+-S\\b",
      "\\bzypper\\s+install\\b",
      "\\bnix\\s+(profile\\s+)?install\\b",
      "\\bnix-env\\s+-i\\b",
      "\\basdf\\s+install\\b",
      "\\bmise\\s+(install|use)\\b",
      "VisualStudio\\.\\*BuildTools",
      "VisualStudio\\.BuildTools",
      "vs_buildtools",
      "Microsoft\\.VisualStudio\\."
    ]
  },
  "identity": {
    "baselineTtlHours": 12
  },
  "rollback": {
    "limit": 3
  },
  "qe": {
    "commands": {}
  },
  "te": {
    "startupSmoke": {
      "maxAgeHours": 24
    }
  },
  "execProof": {
    "enforce": true,
    "requireFreshArtifacts": true,
    "keyTtlMinutes": 15,
    "historyPerKind": 8
  },
  "gateException": {
    "onJudgmentError": "deny"
  },
  "_claudeCodeNotes": {
    "hookAdaptation": "Hooks adapted from Cursor to Claude Code format. Claude Code uses JSON configuration + shell scripts instead of Cursor's hook API. Functionality is equivalent: PreToolUse can block tool calls via permissionDecision: deny.",
    "enforcement": "Technical enforcement via hooks. PreToolUse hooks intercept Write/Edit/Bash/Agent calls before execution. See https://code.claude.com/docs/en/hooks for official documentation.",
    "boundaries": "Hooks enforce objective rules (R5/R10/R29/etc) but cannot verify subjective intent (e.g., whether AskUserQuestion was genuinely used). See mechanical-gates.md §8.7 for disclosed boundaries.",
    "verification": "Use validation scripts in .claude/scripts/ to verify compliance with gate requirements.",
    "crossPlatform": "Path normalization applied: all path detection functions now handle both forward slashes (/) and backslashes (\\) correctly on Windows."
  }
}
