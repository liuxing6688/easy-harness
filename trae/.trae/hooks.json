{
  "version": 1,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Delete|DeleteFile",
        "hooks": [
          {
            "type": "command",
            "command": "node .trae/hooks/gate-dev-workflow.mjs",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash|RunCommand",
        "hooks": [
          {
            "type": "command",
            "command": "node .trae/hooks/gate-dev-shell.mjs",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash|RunCommand",
        "hooks": [
          {
            "type": "command",
            "command": "node .trae/hooks/gate-toolchain-install.mjs",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "node .trae/hooks/gate-role-sequence.mjs",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .trae/hooks/gate-subagent-track.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "loop_limit": 3,
        "hooks": [
          {
            "type": "command",
            "command": "node .trae/hooks/gate-stop-workflow.mjs",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
